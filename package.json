{
  "name": "obsidian-daily-task-gate",
  "version": "0.1.0",
  "description": "Conditionally include tasks when creating an Obsidian daily note.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "daily-notes",
    "tasks"
  ],
  "author": "gutti0",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

